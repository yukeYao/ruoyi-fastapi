# 默认只在本机开放 HTTP，适合验证和云服务器上的首次初始化。
SITE_ADDRESS=:80
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8088
HTTPS_PORT=8443
RELEASE_TAG=local

# 分别生成随机十六进制值。数据库密码直接用于后端连接 URL。
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
JWT_SECRET=

# 可选。在后台上线后再启用智能助手和知识库。
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
AGENT_EMBEDDING_MODEL=
AGENT_EMBEDDING_API_KEY=
AGENT_EMBEDDING_BASE_URL=
