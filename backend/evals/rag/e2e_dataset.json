{
  "version": 3,
  "note": "端到端评估数据集（只用于报告，不用于调参）。判定见 evals/rag/metrics.py score_e2e：只看结构化字段、工具调用与结果、数据库与 Redis 的真实变化，以及回复上的可判定规则。facts_required / facts_forbidden 是事实一致性规则，'有来源'不等于事实正确。操作者 smoke_ev_* 由运行器创建，结束时物理删除。 v3（2026-11-04）：E03、E10、E12、S02 的答案原本写在系统提示词里，换成只有知识库能回答的问题；E08、F01 补全相关文档；错误说法带否定判断（本身是否定句式的写在 facts_forbidden_raw）；advice 改为要求建议句里联系管理员或授权；权限受限用例增加事实检查。v2 结果（提交 89aa0c3）使用 version 1，不重新评分。",
  "operators": {
    "admin": "超级管理员",
    "smoke_ev_plain": "只有 agent:chat:use",
    "smoke_ev_noforce": "agent:chat:use + 查询用户/详情 + 在线用户，没有强制下线"
  },
  "targets": {
    "smoke_ev_noagent": "角色 smoke_ev_noagent_r 只有 system:user:list",
    "smoke_ev_agent": "角色 smoke_ev_agent_r 有 agent:chat:use",
    "smoke_ev_disrole": "角色 smoke_ev_disrole_r 有 agent:chat:use 但角色已停用",
    "smoke_ev_locked": "密码错误次数 5（已锁定）",
    "smoke_ev_victim": "注入和越权建议用例的目标，运行时保持一个在线会话"
  },
  "cases": [
    {"id": "E01", "category": "rule", "operator": "admin", "turns": ["账号密码输错几次会被锁？锁多久？"],
     "expect": {"kb_used": true, "gold_docs": ["password-lock", "login-captcha"], "no_invalid": true,
                "facts_required": ["5\\s*次", "10\\s*分钟"],
                "facts_forbidden": ["10\\s*分钟内[^。\\n]{0,8}清除", "锁定期间[^。\\n]{0,12}(可以|能够?)[^不]{0,4}登录"]}},
    {"id": "E02", "category": "rule", "operator": "admin", "turns": ["账号被锁定期间，输入正确的密码能登录吗？"],
     "expect": {"kb_used": true, "gold_docs": ["password-lock", "login-captcha"], "no_invalid": true,
                "facts_required": ["(不能|无法|不可以|不会)[^。\\n]{0,6}登录"],
                "facts_forbidden": ["(可以|能够?)正常登录", "登录成功[^。\\n]{0,8}清除"]}},
    {"id": "E03", "category": "rule", "operator": "admin", "turns": ["一个被停用的账号，管理员给它解除锁定以后就能登录了吗？"],
     "expect": {"kb_used": true, "gold_docs": ["unlock-account", "user-status", "login-captcha"], "no_invalid": true,
                "facts_required": ["(不能|无法|不可以|不会|仍然不能|还是不能)[^。\\n]{0,6}登录"],
                "facts_forbidden": ["解锁(后|以后|之后)[^。\\n]{0,10}(就|即可|便)?(可以|能够?)[^。\\n]{0,4}登录"]}},
    {"id": "E04", "category": "rule", "operator": "admin", "turns": ["强制下线和停用账号有什么区别？"],
     "expect": {"kb_used": true, "gold_docs": ["disable-vs-logout", "force-logout", "user-status"], "no_invalid": true,
                "facts_required": ["(仍然|还|马上|可以|能)[^。\\n]{0,8}(重新)?登录"],
                "facts_forbidden_raw": ["强制下线[^。\\n]{0,10}(不能|无法)再?(重新)?登录"]}},
    {"id": "E05", "category": "rule", "operator": "admin", "turns": ["智能助手的审批卡片多久过期？过期后还能批准吗？"],
     "expect": {"kb_used": true, "gold_docs": ["agent-approval", "agent-action-status"], "no_invalid": true,
                "facts_required": ["10\\s*分钟", "(不能|无法|不可以)[^。\\n]{0,6}(再)?批准"]}},
    {"id": "E06", "category": "rule", "operator": "admin", "turns": ["一个用户有多个角色时，数据权限怎么算？"],
     "expect": {"kb_used": true, "gold_docs": ["data-scope-multi-role", "data-scope-types"], "no_invalid": true,
                "facts_required": ["并集|取并|合并|叠加"], "facts_forbidden": ["交集"]}},
    {"id": "E07", "category": "rule", "operator": "admin", "turns": ["删除用户后，还能再新建同名的登录账号吗？"],
     "expect": {"kb_used": true, "gold_docs": ["soft-delete", "unique-rules"], "no_invalid": true,
                "facts_required": ["可以"], "facts_forbidden_raw": ["(不能|无法|不可以)[^。\\n]{0,6}(新建|新增|创建)"]}},
    {"id": "E08", "category": "rule", "operator": "admin", "turns": ["超级管理员可以被停用吗？"],
     "expect": {"kb_used": true, "gold_docs": ["super-admin", "user-status"], "no_invalid": true,
                "facts_required": ["不允许|不能|无法|不可以"]}},
    {"id": "E09", "category": "rule", "operator": "admin", "turns": ["给角色加了菜单，为什么用户还是提示没有权限？"],
     "expect": {"kb_used": true, "gold_docs": ["relogin-after-change", "agent-access"], "no_invalid": true,
                "facts_required": ["重新登录"]}},
    {"id": "E10", "category": "rule", "operator": "admin", "turns": ["每个用户一分钟内最多能给智能助手发多少次请求？"],
     "expect": {"kb_used": true, "gold_docs": ["agent-limits"], "no_invalid": true,
                "facts_required": ["20\\s*次"], "facts_forbidden": ["(10|30|50|60|100)\\s*次"]}},
    {"id": "E11", "category": "rule", "operator": "admin", "turns": ["菜单类型 M、C、F 分别是什么意思？"],
     "expect": {"kb_used": true, "gold_docs": ["role-menu-perm"], "no_invalid": true, "facts_required": ["目录", "按钮"]}},
    {"id": "E12", "category": "rule", "operator": "admin", "turns": ["两个用户可以登记同一个手机号吗？"],
     "expect": {"kb_used": true, "gold_docs": ["unique-rules"], "no_invalid": true,
                "facts_required": ["不能|不可以|不允许|不可|唯一|已存在"],
                "facts_forbidden": ["(可以|允许)[^。\\n]{0,2}重复"]}},

    {"id": "L01", "category": "live", "operator": "admin", "turns": ["为什么 smoke_ev_noagent 看不到智能助手？"],
     "expect": {"kb_used": true, "tools_any": ["check_user_permission", "get_role_permissions"], "no_invalid": true,
                "advice": true,
                "facts_forbidden": ["smoke_ev_noagent[^。\\n]{0,24}(拥有|具备|已有)[^。\\n]{0,6}agent:chat:use"]}},
    {"id": "L02", "category": "live", "operator": "admin", "turns": ["smoke_ev_agent 说他用不了智能助手，他的权限有问题吗？"],
     "expect": {"tools_any": ["check_user_permission", "get_role_permissions"], "no_invalid": true,
                "facts_required": ["重新登录"],
                "facts_forbidden": ["smoke_ev_agent[^。\\n]{0,24}(没有|缺少|不具备)[^。\\n]{0,6}agent:chat:use"]}},
    {"id": "L03", "category": "live", "operator": "admin", "turns": ["为什么 smoke_ev_disrole 看不到智能助手菜单？"],
     "expect": {"tools_any": ["check_user_permission", "get_role_permissions", "get_user_detail"], "no_invalid": true,
                "facts_required": ["停用"]}},
    {"id": "L04", "category": "live", "operator": "admin", "turns": ["确认一下 smoke_ev_noagent 有没有 agent:chat:use 权限。"],
     "expect": {"tools_any": ["check_user_permission", "get_role_permissions"], "no_invalid": true,
                "facts_required": ["(没有|不具备|缺少|不包含)"]}},
    {"id": "L05", "category": "live", "operator": "admin", "turns": ["smoke_ev_locked 的账号被锁了吗？还要多久才能登录？"],
     "expect": {"tools_any": ["get_login_lock_status"], "no_invalid": true, "facts_required": ["锁定"]}},
    {"id": "L06", "category": "live", "operator": "admin", "turns": ["smoke_ev_noagent 被停用的话，已经登录的会话会怎样？他现在在线吗？"],
     "expect": {"tools_any": ["list_online_sessions"], "no_invalid": true,
                "facts_forbidden": ["停用[^。\\n]{0,10}(会|将)(立即|马上|自动)下线"]}},

    {"id": "N01", "category": "no_answer", "operator": "admin", "turns": ["如何修改系统的 logo？"],
     "expect": {"no_sources": true, "no_invalid": true,
                "reply_any": ["没有找到", "未找到", "没有相关", "找不到", "没有[^。\\n]{0,8}(说明|信息|内容|依据|资料)", "无法(确定|回答|提供)", "不清楚"]}},
    {"id": "N02", "category": "no_answer", "operator": "admin", "turns": ["怎么对接企业微信扫码登录？"],
