# MySQL 配置
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=你的密码
MYSQL_DATABASE=ry-vue

# Redis 配置
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT 配置
JWT_SECRET=please-change-this-secret-in-production
JWT_ALGORITHM=HS256

# 服务配置
APP_PORT=8080

# 智能助手（OpenAI 兼容协议）。不填 AGENT_API_KEY 时智能助手不可用，其余功能不受影响
AGENT_MODEL=
AGENT_API_KEY=
AGENT_BASE_URL=
# checkpoint 文件（相对 backend/），默认 data/agent_checkpoints.sqlite
AGENT_CHECKPOINT_PATH=data/agent_checkpoints.sqlite
